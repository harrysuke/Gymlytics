# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
API_HOST=0.0.0.0
PUBLIC_API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (SQLite now; swap dialect in packages/db for PostgreSQL later)
# ---------------------------------------------------------------------------
DATABASE_URL=file:./data/gymlytics.db
# PostgreSQL example (future): postgres://user:pass@localhost:5432/gymlytics

# ---------------------------------------------------------------------------
# Auth & security
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-32-byte-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
DEVICE_TOKEN_TTL_SECONDS=43200
REFRESH_TOKEN_TTL_DAYS=30
KIOSK_PIN_LENGTH=4
HLC_DEVICE_ID=kiosk-main-lobby

# Shared secret the kiosk presents once to pair itself and receive a device
# token. Rotate it to force every tablet to re-pair.
KIOSK_DEVICE_KEY=dev-kiosk-key

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Origin used inside iframe snippets generated by /v1/widgets. Change this to
# the public web app URL when embedding on member-facing websites.
PUBLIC_WEB_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Background jobs (reminders, dunning, eligibility scans). Set to "false"
# when running a second API instance so only one process owns the timers.
# ---------------------------------------------------------------------------
JOBS_ENABLED=true

# ---------------------------------------------------------------------------
# Stripe (global cards + subscriptions)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ---------------------------------------------------------------------------
# Billplz (Malaysia FPX / online banking, one-off day passes & POS)
# ---------------------------------------------------------------------------
BILLPLZ_API_KEY=xxx
BILLPLZ_COLLECTION_ID=xxx
BILLPLZ_SIGNATURE_KEY=xxx
BILLPLZ_X_SIGNATURE_KEY=xxx

# ---------------------------------------------------------------------------
# iPay88 (SEA local cards, FPX, recurring where enabled)
# ---------------------------------------------------------------------------
IPAY88_MERCHANT_CODE=xxx
IPAY88_MERCHANT_KEY=xxx
IPAY88_SIGNATURE_KEY=xxx

# ---------------------------------------------------------------------------
# Notifications (cron: missed class, belt eligibility, dunning)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=xxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_FROM_NUMBER=+60xxx
SENDGRID_API_KEY=SG.xxx
EMAIL_FROM=noreply@gymlytics.app

# ---------------------------------------------------------------------------
# Kiosk sync
# ---------------------------------------------------------------------------
SYNC_BATCH_SIZE=100
SYNC_PUSH_INTERVAL_MS=5000
SYNC_BACKOFF_BASE_MS=1000
SYNC_BACKOFF_MAX_MS=60000

# ---------------------------------------------------------------------------
# Web console (apps/web) — Vite inlines these at build time.
# ---------------------------------------------------------------------------
# Leave unset to use the Vite same-origin proxy (/v1 -> API). Set this only
# when the API is hosted on a different origin.
# VITE_API_URL=http://localhost:3000
VITE_KIOSK_DEVICE_ID=kiosk-lobby-01

# ---------------------------------------------------------------------------
# Mobile app (apps/mobile) — Expo inlines EXPO_PUBLIC_* at bundle time.
# On a physical device, point this at your machine's LAN address: localhost
# resolves to the phone itself, not your laptop.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_ACADEMY_SLUG=gymlytics-demo
