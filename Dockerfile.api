# syntax=docker/dockerfile:1.7
# Fastify API — pnpm workspace, native better-sqlite3, SQLite on a named volume.

# ---------------------------------------------------------------------------
# deps: install the whole workspace from the lockfile.
# Build tools are needed because better-sqlite3 may have to compile if a
# prebuilt binary for the image's Node ABI is unavailable.
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS deps

RUN corepack enable \
 && corepack prepare pnpm@9.12.0 --activate \
 && apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates python3 make g++ \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Manifests first so dependency installation is cached across code changes.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/*/package.json ./apps/
COPY packages/*/package.json ./packages/

RUN pnpm install --frozen-lockfile

# ---------------------------------------------------------------------------
# build: fail fast if the API no longer bundles.
# The bundle still imports the @gymlytics/* workspace packages (tsup leaves
# dependencies external), so the runtime keeps the source tree and uses tsx.
# ---------------------------------------------------------------------------
FROM deps AS build
COPY . .
RUN pnpm --filter @gymlytics/api build

# ---------------------------------------------------------------------------
# runner: no compiler toolchain, no dev data, one SQLite volume.
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS runner

ENV NODE_ENV=production \
    DATABASE_URL=file:/data/gymlytics.db \
    API_PORT=3000 \
    API_HOST=0.0.0.0

RUN corepack enable \
 && corepack prepare pnpm@9.12.0 --activate \
 && apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /data

WORKDIR /app
COPY --from=build /app /app
COPY apps/api/docker-entrypoint.sh /usr/local/bin/gymlytics-entrypoint
RUN chmod +x /usr/local/bin/gymlytics-entrypoint

VOLUME ["/data"]
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.API_PORT || 3000) + '/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

ENTRYPOINT ["gymlytics-entrypoint"]
