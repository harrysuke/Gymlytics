{
  "name": "@gymlytics/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts --format esm --target node20 --out-dir dist --clean --sourcemap --external better-sqlite3",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@gymlytics/db": "workspace:*",
    "@gymlytics/payments": "workspace:*",
    "@gymlytics/shared": "workspace:*",
    "@gymlytics/sync": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.1.0",
    "pdf-lib": "^1.17.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
