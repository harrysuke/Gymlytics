{
  "name": "gymlytics",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @gymlytics/db generate",
    "db:migrate": "pnpm --filter @gymlytics/db migrate",
    "db:seed": "pnpm --filter @gymlytics/db seed",
    "db:studio": "pnpm --filter @gymlytics/db studio",
    "format": "prettier --write \"**/*.{ts,tsx,vue,json,md,yaml}\""
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "playwright": "1.48.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "rollup": "npm:@rollup/wasm-node@^4.24.0",
      "better-sqlite3": "11.10.0"
    }
  }
}
